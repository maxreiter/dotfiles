# Autostart polkit for authentication.
exec "/usr/lib/polkit-kde-authentication-agent-1"

# Autostart mako for notifications.
# Configure at ~/.config/mako/config.
exec mako

# Autostart swayidle for screen locking & timeout.
# Configure at ~/.config/swayidle/config.
exec swayidle

# Autostart Firefox.
exec firefox

# Autostart Chrome.
exec google-chrome-stable
