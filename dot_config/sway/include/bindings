# Open a terminal.
bindsym $mod+Return exec $term

# Kill the focused window.
bindsym $mod+Shift+q kill

# Open the application launcher.
bindsym $mod+d exec $menu

# Lock the screen.
bindsym $mod+l exec swaylock

# Reload the config file in place.
bindsym $mod+Shift+c reload

# Open a prompt that exits Sway.
bindsym $mod+Shift+e exec swaynag -t warning -m "Are you sure you want to exit?" -B "Yes" "swaymsg exit"

# Execute screenshot script.
bindsym $mod+Shift+s exec $scripts/screenshot.fish

# Open Firefox and Chrome.
bindsym $mod+Shift+b exec google-chrome-stable; exec firefox

# Open Discord.
bindsym $mod+Shift+d exec discord --enable-features=UseOzonePlatform --ozone-platform=wayland

# Execute color picker script.
bindsym $mod+Shift+p exec $scripts/color-picker.fish

# Resize the curent window to half of the output size.
bindsym $mod+Shift+r resize set width 50

# Open the terminal and launch ncspot.
bindsym $mod+Shift+m exec $term ncspot

# Enable dragging floating windows with the modifier key & mouse 1.
# Resize windows with the modifier key & mouse 2.
floating_modifier $mod normal

# Toggle floating on the focused window.
bindsym $mod+s floating toggle

# Switch focus using the modifier & arrow keys.
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move windows using the modifier, shift, and arrow keys.
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Switch workspaces with the modifier and number keys.
bindsym $mod+1 workspace $ws-1
bindsym $mod+2 workspace $ws-2
bindsym $mod+3 workspace $ws-3
bindsym $mod+4 workspace $ws-4
bindsym $mod+5 workspace $ws-5
bindsym $mod+6 workspace $ws-6
bindsym $mod+7 workspace $ws-7
bindsym $mod+8 workspace $ws-8
bindsym $mod+9 workspace $ws-9
bindsym $mod+0 workspace $ws-10

# Move windows to different workspaces using the modifier, shift, and number keys.
bindsym $mod+Shift+1 move container to workspace $ws-1
bindsym $mod+Shift+2 move container to workspace $ws-2
bindsym $mod+Shift+3 move container to workspace $ws-3
bindsym $mod+Shift+4 move container to workspace $ws-4
bindsym $mod+Shift+5 move container to workspace $ws-5
bindsym $mod+Shift+6 move container to workspace $ws-6
bindsym $mod+Shift+7 move container to workspace $ws-7
bindsym $mod+Shift+8 move container to workspace $ws-8
bindsym $mod+Shift+9 move container to workspace $ws-9
bindsym $mod+Shift+0 move container to workspace $ws-10

# Toggle splitting the screen horizontally.
bindsym $mod+b splith

# Toggle splitting the screen vertically.
bindsym $mod+v splitv

# Toggle fullscreen on the focused window.
bindsym $mod+f fullscreen

# Toggle floating on the focused window.
bindsym $mod+Space floating toggle

# Move focused window to the scratchpad.
bindsym $mod+minus move scratchpad

# Retrieve a window from the scratchpad.
bindsym $mod+Shift+minus scratchpad show

# Define resize mode.
mode "resize" {
	# In resize mode, grow or shrink the focused window with the arrow keys.
	bindsym Left resize shrink width 10px
	bindsym Down resize grow height 10px
	bindsym Up resize shrink height 10px
	bindsym Right resize grow width 10px

	# Exit resize mode.
	bindsym Return mode "default"
	bindsym Escape mode "default"
}

# Enable resize mode.
bindsym $mod+r mode "resize"
