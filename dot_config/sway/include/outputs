# Set the background for all outputs.
output * bg /home/max/.xdg/pictures/wallpapers/space1.png fill

# Scale Sway to ensure everything fits 4k.
output DP-1 scale 2

# Set the position & resolution of the main output.
output DP-1 pos 0 0 res 3840x2160

# Set the position & resolution of the secondary output.
# Using a negative number positions the output on the left of DP-1.
output DP-2 pos -1080 0 res 1920x1080

# Transform the rotation of the output to be vertical.
output DP-2 transform 90
