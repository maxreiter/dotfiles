{
	"layer": "top",
	"position": "top",
	"spacing": 10,
	"modules-left": [
		"sway/workspaces",
		"sway/mode"
	],
	"modules-center": [
		"sway/window"
	],
	"modules-right": [
		"tray",
		"wireplumber",
		"network",
		"clock#date",
		"clock#time"
	],
	"include": [
		"$HOME/.config/waybar/modules/sway-workspaces.jsonc",
		"$HOME/.config/waybar/modules/sway-mode.jsonc",

		"$HOME/.config/waybar/modules/sway-window.jsonc",

		"$HOME/.config/waybar/modules/clock.jsonc",
		"$HOME/.config/waybar/modules/network.jsonc",
		"$HOME/.config/waybar/modules/tray.jsonc",
		"$HOME/.config/waybar/modules/wireplumber.jsonc"
	]
}
